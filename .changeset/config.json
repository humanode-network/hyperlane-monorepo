{
  "$schema": "https://unpkg.com/@changesets/config@2.3.1/schema.json",
  "changelog": "@changesets/cli/changelog",
  "commit": true,
  "fixed": [
    [
      "@humanode-hyperlane/aleo-sdk",
      "@humanode-hyperlane/starknet-core",
      "@humanode-hyperlane/ccip-server",
      "@humanode-hyperlane/cli",
      "@humanode-hyperlane/cosmos-sdk",
      "@humanode-hyperlane/cosmos-types",
      "@humanode-hyperlane/github-proxy",
      "@humanode-hyperlane/helloworld",
      "@humanode-hyperlane/http-registry-server",
      "@humanode-hyperlane/infra",
      "@humanode-hyperlane/radix-sdk",
      "@humanode-hyperlane/sealevel-sdk",
      "@humanode-hyperlane/sdk",
      "@humanode-hyperlane/tsconfig",
      "@humanode-hyperlane/utils",
      "@humanode-hyperlane/widgets"
    ]
  ],
  "linked": [
    [
      "@humanode-hyperlane/deploy-sdk",
      "@humanode-hyperlane/provider-sdk"
    ]
  ],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": [],
  "snapshot": {
    "useCalculatedVersion": true,
    "prereleaseTemplate": "{tag}.{commit}"
  }
}
